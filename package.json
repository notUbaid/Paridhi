{
  "name": "paridhi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remote protection for vacant land in India owned by people living abroad",
  "workspaces": [
    "web",
    "services"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "test": "npm test -w services",
    "typecheck": "npm run typecheck -w services",
    "lint": "npm run lint -w web",
    "start": "npm start -w services",
    "dev:api": "npm run dev -w services",
    "dev:web": "npm run dev -w web",
    "keygen": "npm run keygen -w services",
    "db:seed": "npm run db:seed -w services --"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
