# Copy to your shell or hosting provider's environment settings. Never commit real values.

# "false" hides the demo banner and disables /api/demo routes. Defaults to on.
PARIDHI_DEMO_MODE=true

# Shared secret that camera devices send as "Authorization: Bearer <token>". Leave empty to disable device ingest.
PARIDHI_DEVICE_TOKEN=

# Ed25519 private key for signing evidence (base64 PKCS#8). Generate with: npm run keygen
PARIDHI_SIGNING_KEY=

PORT=4000
