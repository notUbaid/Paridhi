# Copy to .env for local development (gitignored), or set these in your hosting provider.
# Never commit real values.

# --- Database and sign-in ---------------------------------------------------------------
# The website and the sample-plot demo at /demo always run. DATABASE_URL turns on owner
# accounts (/app) and the staff console (/staff); people sign in with Supabase Auth.
#
# Supabase dashboard > Connect > Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=
# Supabase dashboard > Project Settings > API. Both are public values. Without DATABASE_URL they
# are still used to save website plot requests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only for older projects still signing tokens with the legacy shared JWT secret.
SUPABASE_JWT_SECRET=
# Optional: Supabase's CA certificate (PEM) so the database certificate is verified.
DATABASE_CA_CERT=

# --- Devices and evidence ---------------------------------------------------------------
# Shared secret that camera devices send as "Authorization: Bearer <token>". Empty disables device ingest.
PARIDHI_DEVICE_TOKEN=
# Ed25519 private key for signing evidence (base64 PKCS#8). Generate with: npm run keygen
PARIDHI_SIGNING_KEY=

# --- Website ------------------------------------------------------------------------------
# WhatsApp number with country code (shows a WhatsApp button) and a contact email. Both optional.
PARIDHI_CONTACT_WHATSAPP=
PARIDHI_CONTACT_EMAIL=
# Set to "off" to remove the sample-plot demo.
PARIDHI_DEMO=

PORT=4000
