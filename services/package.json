{
  "name": "@paridhi/services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paridhi API: property records, owner actions and signed evidence",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/api.test.ts test/domain.test.ts test/evidence.test.ts test/postgres.test.ts test/staff.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "keygen": "tsx scripts/generate-signing-key.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "staff:add": "tsx scripts/add-staff.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "^6.2.18",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
